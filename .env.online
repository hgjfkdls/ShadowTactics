# ── Modo de conexión ──
# MODE = local   # → cliente y servidor usan LOCAL_URL + puertos
MODE = online  # → cliente/servidor apuntan a CLIENT_URL y SERVER_URL
 
# ── Despliegue automático ──
DEPLOY = normal      → flujo completo: identidad → dados → despliegue (cada paso manual)
# DEPLOY = simulated # → tras reveal de identidades, simula el game state automáticamente
 
# ── Local ──
LOCAL_URL=http://localhost
CLIENT_PORT=5173
SERVER_PORT=3000
 
# ── Online (misma URL para cliente y servidor) ──
